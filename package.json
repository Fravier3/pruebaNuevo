{
  "name": "fran-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-sw.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
